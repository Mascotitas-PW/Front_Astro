---
import '../styles/Neumorfismo.css';
import '../styles/global.css';
import App from '../App.jsx';
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Mascotitas, tu tienda en línea para consentir a tus mascotas." />

		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />

		<title>Mascotitas</title>
	</head>

	<body>
		<App client:only="react" />
		<script is:inline>
		if ('serviceWorker' in navigator) {
			window.addEventListener('load', () => {
			navigator.serviceWorker.register('/Front_Astro/sw.js', { scope: '/Front_Astro/' })
				.then((reg) => console.log('SW registrado:', reg.scope))
				.catch((err) => console.error('Error al registrar SW:', err));
			});
		}
		</script>
	</body>
</html>